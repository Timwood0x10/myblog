        <title>Evaluation Framework — How We Know If an Agent Is Actually Good</title>
        <published>2026-06-28T00:00:00+00:00</published>
        <updated>2026-06-28T00:00:00+00:00</updated>
        
        <author>
          <name>Unknown</name>
        </author>
        
        <link rel="alternate" type="text/html" href="https://Timwood0x10.github.io/myblog/log/ARES/21-evaluation-framework/"/>
